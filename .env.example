# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Google OAuth client ID, injected into the Chrome manifest's `oauth2.client_id`
# at build time. Leave empty to omit the `oauth2` key (the default). Unused
# until Phase 3.
SBW_GOOGLE_CLIENT_ID=

# NOTE: SBW_TEST is deliberately NOT read from .env files. A test build must be
# requested explicitly on the command line (SBW_TEST=1 pnpm build) so a stray
# .env file can never turn a production build into a test build.
