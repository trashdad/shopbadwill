{
  // Base options (strict, noUncheckedIndexedAccess, Bundler resolution, path
  // aliases) are generated by `wxt prepare` (run on postinstall).
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // TypeScript 6 no longer includes @types/* automatically.
    "types": ["node"]
  }
}
