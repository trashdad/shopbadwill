{
  "manifest_version": 3,
  "permissions": [
    "storage",
    "alarms",
    "identity"
  ],
  "optional_permissions": [
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://shopgoodwill.com/*",
    "https://buyerapi.shopgoodwill.com/*"
  ],
  "optional_host_permissions": [
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://ntfy.sh/*"
  ],
  "content_script_matches": [
    [
      "https://shopgoodwill.com/*"
    ]
  ],
  "web_accessible_resources": null,
  "externally_connectable": null,
  "content_security_policy": null,
  "commands": {
    "kill-switch": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Kill switch: stop all ShopBadwill automation"
    }
  },
  "minimum_chrome_version": null,
  "oauth2": null,
  "browser_specific_settings": {
    "gecko": {
      "id": "shopbadwill@trashdad.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
