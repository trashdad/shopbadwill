{
  "name": "shopbadwill",
  "description": "A Firefox and Chrome extension for assisting with shopping at shopgoodwill.com",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "lint": "eslint . --max-warnings=0",
    "lint:webext": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-vitest.ts unit",
    "test:contract": "node scripts/run-vitest.ts contract",
    "test:dom": "node scripts/run-vitest.ts dom",
    "test:integration": "node scripts/run-vitest.ts integration",
    "test:e2e:chromium": "node scripts/run-playwright.ts",
    "test:e2e:firefox": "node -e \"console.log('test:e2e:firefox: no Firefox E2E suite yet (runner chosen by S-6, suite added by T-40)')\"",
    "check:permissions": "node -e \"console.log('check:permissions: not yet implemented (T-06)')\"",
    "check:prod-bundle": "node -e \"console.log('check:prod-bundle: not yet implemented (T-06)')\"",
    "check:all": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:contract && pnpm test:dom && pnpm test:integration && pnpm build && pnpm build:firefox && pnpm lint:webext && pnpm check:permissions && pnpm check:prod-bundle"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "25.9.9",
    "eslint": "10.12.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
